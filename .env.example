# --- Server (Express) ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key

GEMINI_API_KEY=mock-gemini-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_BACKGROUND_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GOOGLE_MAPS_SERVER_API_KEY=mock-maps-key
OPENWEATHERMAP_API_KEY=mock-weather-key

CRON_SECRET=mock-cron-secret

# --- Client (Vite — must be prefixed VITE_ to be exposed to the browser) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=mock-anon-key
VITE_GOOGLE_MAPS_BROWSER_KEY=mock-maps-key
